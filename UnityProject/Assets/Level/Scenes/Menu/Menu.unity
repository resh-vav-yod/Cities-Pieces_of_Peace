  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Hello, this is a very simple demo.\n\nDue to issues with the local database,
    output in Chinese is temporarily unavailable. Sorry.\n\nThis demo includes three
    scenes, which are:\n1. Menu        2. Earth        3. Battle\n\n- In the Earth
    interface, you can use \"WADS\" or the \"right mouse button\" to move the view;
    the scroll wheel can change the field of view.\n- Clicking on a land parcel with
    the \"left mouse button\" will highlight the selected parcel and pop up a UI
    displaying area information. The \"Goin\" button in the UI can jump to the battle
    scene.\n\n- In the battle scene, the change of perspective is the same as in
    the Earth scene, but the \"Q/E\" keys are added to rotate the view. \n- Pressing
    \"B\" at the same time can turn the construction mode on/off. \n- In normal mode,
    left-clicking a \"Cube\" with the mouse can open the production button to manufacture
    a \"Capsule\", and pressing \"ESC\" closes the production button. \n- The \"Capsule\"
    can automatically navigate to attack other players' \"Capsules\" (just like the
    video demonstration uploaded with the demo).\n- The \"back\" in the upper left
    corner can return to the Earth interface.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
